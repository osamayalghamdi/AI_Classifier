# ── LLM — choose ONE block ────────────────────────────────────────────

# Local (default — no API key needed)
# LLM_MODEL=ollama/classifier-qwen
# LLM_API_BASE=http://localhost:11434

# API — set LLM_MODEL + LLM_API_KEY, comment out the local block above
LLM_MODEL=openrouter/qwen/qwen3.6-35b-a3b
LLM_API_KEY=sk-or-...07dd

# ── Ngrok — get your authtoken at https://dashboard.ngrok.com ──────
# NGROK_AUTHTOKEN=your_token_here

# ── Server ──
# HOST=0.0.0.0
# PORT=8000

# ── Similarity store ──
# SIMILARITY_THRESHOLD=0.35
# DB_PATH=incidents.db

# ── LLM re-ranking ──
USE_LLM_RERANKING=1
# LLM_RERANK_CANDIDATES=100
