# ── AI_Classifier deployment configuration ─────────────────────────────
# Copy to .env and fill in:   cp .env.example .env
# NEVER commit .env — it holds secrets. Every value here is optional
# (safe defaults are shown); the compose stack fails loudly only when a
# REQUIRED value (POSTGRES_PASSWORD) is missing.

# ══ LLM backend — pick ONE block ══════════════════════════════════════

# (A) Remote API (company / OpenRouter). Set LLM_API_KEY — the app fails
#     loudly on the first LLM call if it's unset.
LLM_MODEL=openai/qwen3.6
LLM_API_BASE=https://llms.elm.sa/v1
LLM_API_KEY=

# (B) Local Ollama — uncomment to use (no API key needed):
# LLM_MODEL=ollama/qwen2.5:7b
# LLM_API_BASE=http://localhost:11434

# ══ Model registry — enable / disable per model ═══════════════════════
# Each model is wired to a provider: OpenRouter (dev/testing) or ELM
# (company endpoint, used at deploy). The classifier uses the first
# ENABLED model with role=classifier; OCR the enabled role=ocr; the
# reranker role=reranker. To switch provider: disable the current
# classifier entry and enable the other. When no MODEL_* flag is set,
# QWEN3_6_OR (OpenRouter) defaults ENABLED if LLM_MODEL starts with
# openrouter/; QWEN3_6 (ELM) if it starts with openai/ (backward compat).
# Toggle via the admin console → Models (writes MODEL_<NAME>_ENABLED to
# the env file; restart required).
# MODEL_QWEN3_6_OR_ENABLED=1
# MODEL_QWEN3_6_ENABLED=0
# MODEL_GEMMA_4_ENABLED=0
# MODEL_GPT_OSS_120B_ENABLED=0
# MODEL_QWEN3_32B_ENABLED=0
# MODEL_QWEN2_5_14B_INSTRUCT_ENABLED=0
# MODEL_QWEN3_CODER_ENABLED=0
# MODEL_QWEN3_VL_32B_ENABLED=0
# MODEL_OLMOCR_2_7B_ENABLED=0
# MODEL_BGE_RERANKER_ENABLED=0
# Optional per-model overrides (default: inherit the provider wiring —
# OpenRouter → LLM_API_BASE/LLM_API_KEY; ELM → BASE_URL/UNIVERSAL_API_KEY):
# MODEL_<NAME>_ID=openai/qwen3.6
# MODEL_<NAME>_API_BASE=https://llms.elm.sa/v1
# MODEL_<NAME>_API_KEY=

# ══ Embeddings — EXTERNAL endpoint (the image ships NO model) ═════════
# Similarity / clustering POST the incident text here. It must be an
# OpenAI-compatible /embeddings endpoint.
# EMBEDDING_DIM must match what the endpoint returns AND the vector column
# created on the first startup (change it only together with a fresh schema).
EMBEDDING_PROVIDER=external
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_S=30

# ══ OCR — a SEPARATE service; this app only needs its URL ═════════════
# The API POSTs each incident attachment to OCR_SERVICE_URL and stores the
# returned text on the incident record. Leave the URL empty to record
# attachments by name only (no OCR calls).
OCR_ENABLED=1
OCR_SERVICE_URL=
OCR_TIMEOUT_S=60
OCR_MAX_ATTACHMENT_MB=15

# ── Optional: the bundled OCR service (backend/ocr/, compose profile) ──
# Not started by default. To host it yourself:
#   docker compose --profile ocr up -d      + OCR_SERVICE_URL=http://ocr:8001
# It ships NO local model either — it calls the company vision endpoint
# (OpenAI-compatible chat-completions) with the image. ELM_API_KEY is
# REQUIRED: the service refuses to start without it.
OCR_USE_ELM=1
ELM_API_URL=https://llms.elm.sa/v1/chat/completions
ELM_MODEL=openai/qwen3-vl:32b
ELM_API_KEY=
# Per-call timeout for the vision request.
OCR_ELM_TIMEOUT_S=60
# Rendered-page cap for PDF attachments (~26 MB RAM per page at 300 dpi).
OCR_MAX_PDF_PAGES=10

# ══ LLM resilience (call_llm retry/backoff) ══════════════════════════
# Per-call request timeout, seconds (0 = provider default).
# LLM_TIMEOUT_S=60
# Retries for TRANSIENT failures only (429/5xx/timeouts) — exponential
# backoff + jitter, honouring Retry-After. Auth (401/403), credits (402),
# unknown model (404), bad request (400) fail FAST (zero retries).
# Total attempts = 1 + LLM_MAX_RETRIES.
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_S=2

# ══ PostgreSQL (shared by the postgres service AND the api) ═══════════
# REQUIRED — compose refuses to start without POSTGRES_PASSWORD.
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=
POSTGRES_DB=ai_incidents
# Host port for Postgres (default 5432)
PG_PORT=5432
# Bind address for the published ports. DEFAULT 127.0.0.1 = reachable from
# this host only (psql, migrations, curl) — never from the LAN/WAN. Set
# 0.0.0.0 only when an external tool must connect directly.
# The ONE public port is NGINX_PORT (dashboard + API proxy).
PG_BIND=127.0.0.1

# ══ W3 integration API — bearer token ════════════════════════════════
# Every non-health endpoint requires:  Authorization: Bearer <token>
# FAIL-CLOSED: empty means ALL integration requests are rejected (401).
INTEGRATION_API_TOKEN=
# Admin console credential (recuperated by /admin/*). Set it to SEPARATE the
# console from the integration credential: the integration token travels to
# the SMAX connector (webhook config, docs, proxy logs) while /admin/* can
# write .env, reset the database and run pytest in-container.
# Empty = /admin/* falls back to INTEGRATION_API_TOKEN (logged as a warning).
ADMIN_TOKEN=
# Async worker: 1 = background ingest queue runs in the API process.
# Set 0 only for tests. (Default: 1)
INTEGRATION_WORKER_ENABLED=1
# Write-back mode: 0 = suggestions to separate area (SAFEST), 1 = direct
INTEGRATION_WRITE_BACK=0
# Async ingest job behavior (retry/flag)
INTEGRATION_MAX_ATTEMPTS=3
INTEGRATION_POLL_S=5
INTEGRATION_RETRY_BASE_S=2

# ══ Ticketing seam (W2 SEAMS) — IN-PROCESS WORKER IS LOCAL-ONLY ═══════
# The real SMAX adapter moved out into the standalone connector
# (integrations/smax) — see the SMAX connector block below. In-process,
# the sync worker only supports the local (store-backed) fake source,
# used by tests and offline runs.
TICKETING_SOURCE=local
TICKETING_API_URL=http://localhost:8002
TICKETING_API_TOKEN=
TICKETING_DRY_RUN=false
# Sync poller interval (seconds)
SYNC_INTERVAL=60

# ══ SMAX connector (integrations/smax) — separate process ═════════════
# Standalone ticketing connector: polls SMAX and submits incidents to the
# classifier's public API. Run with: python -m integrations.smax.main
# SMAX_API_URL=https://smax.example.com
# SMAX_API_TOKEN=
# Dry-run gate: true (default) logs the suggestion payload, never posts.
SMAX_DRY_RUN=true
# Write-back mode: none | suggestions (default, side channel) | full
SMAX_WRITE_BACK=suggestions
# Poll interval (seconds) and local since-stamp path (runtime state,
# never committed)
SMAX_POLL_S=60
# SMAX_SYNC_STAMP_PATH=./.last_sync
# Classifier public API (E1-E9) the connector submits to. The token is
# the server's INTEGRATION_API_TOKEN.
CLASSIFIER_API_URL=http://localhost:8000
CLASSIFIER_API_TOKEN=

# ══ Published ports (compose) ════════════════════════════════════════
# nginx is the only intentionally public listener: dashboard + /api proxy.
# The API itself (and OCR) bind to 127.0.0.1 by default; raise the bind only
# if something off-host must reach a raw port. Inside the compose network the
# services always reach each other by name, so nginx keeps working either way.
NGINX_PORT=8082
API_PORT=8000
API_BIND=127.0.0.1
OCR_PORT=8001
OCR_BIND=127.0.0.1

# ══ Classification tuning ═════════════════════════════════════════════
# Live-duplicate similarity threshold (0.35 used by the compose deploy;
# config default 0.80 is stricter)
SIMILARITY_THRESHOLD=0.35
# Cascade retries (v3 resilience): when a cascade stage's LLM response
# fails to parse/validate (transient bad response, e.g. stage-2 "service
# selection failed"), re-run the WHOLE cascade up to this many extra times
# before accepting the honest low-confidence fallback. 0 = single attempt.
# CLASSIFY_CASCADE_RETRIES=2
# Embedding model — BAKED into the image (BAAI/bge-m3, HF_HUB_OFFLINE=1).
# Do not change at runtime unless you rebuild the image with that model.

# ══ Server ════════════════════════════════════════════════════════════
# HOST=0.0.0.0
# PORT=8000

# ══ Ticket text field names (import mapping) ══════════════════════════
# TICKET_TITLE_FIELDS=DisplayLabel,title
# TICKET_DESCRIPTION_FIELDS=Description,description,desc
