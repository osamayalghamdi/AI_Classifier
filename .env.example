# ── LLM configuration ──
# Local (default): uses Ollama with qwen2.5:7b
LLM_MODEL=ollama/qwen2.5:7b
# LLM_API_BASE=http://ollama:11434  # set automatically in Docker

# Remote providers (alternative):
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=sk-ant-...

# ── Server ──
# HOST=0.0.0.0
# PORT=8000

# ── Similarity store ──
# SIMILARITY_THRESHOLD=0.35
# DB_PATH=incidents.db
