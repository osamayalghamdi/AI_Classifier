# ── LLM configuration ──
# Pick one pattern:

# Option A: OpenAI (default)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# Option B: Anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=sk-ant-...

# Option C: local Ollama
# LLM_MODEL=ollama/llama3.2
# LLM_API_BASE=http://localhost:11434

# ── Server ──
# HOST=0.0.0.0
# PORT=8000
