# SMAX connector configuration — all of it lives in this folder.
#
#   cp .env.example .env && edit        # then: python -m integrations.smax.main
#
# Auth is a login exchange, not a static token: the connector POSTs the
# integration account below to
#   POST {SMAX_BASE}/auth/authentication-endpoint/authenticate/token?TENANTID={SMAX_TENANT}
# and carries the returned JWT in a Cookie on every later call
# (SMAX_INTEGRATION.md §3 — kept beside this file).
#
# The connector runs as its own process and imports nothing from the classifier
# app. These values are read from the environment; the `.env` beside this file is
# loaded automatically when present, and real environment variables always win:
#
#   SMAX_PASS=… python -m integrations.smax.main        # overrides the file
#
# Nothing SMAX-related is needed in the app's .env (repo root). The only value
# the two sides share is the classifier token: CLASSIFIER_API_TOKEN here must
# equal the server's INTEGRATION_API_TOKEN.

# ── SMAX — the upstream ticketing system (all four required when it runs) ──
SMAX_BASE=https://smax.example.com
SMAX_TENANT=
SMAX_USER=
SMAX_PASS=

# Client-side token refresh interval (the handover's example uses 25 min). A
# 401/403 always forces a refresh, so this is a hint, not a guarantee.
SMAX_TOKEN_TTL_S=1500

# Search: page size (the API caps at 250), the custom entity field, and the
# fixed UTC offset used to convert date boundaries (3 = Riyadh).
SMAX_PAGE_SIZE=250
SMAX_ENTITY_FIELD=Entity_c
SMAX_UTC_OFFSET_HOURS=3

# Attachments: only files up to this size are downloaded and carried to the
# classifier as base64; larger ones are sent by name only.
SMAX_MAX_ATTACHMENT_MB=15

# Poll loop
SMAX_POLL_S=60
SMAX_SYNC_STAMP_PATH=./.last_sync

# Write-back. The handover documents NO write endpoint, so the connector logs the
# suggestion payload instead of posting it — SMAX_WRITE_BACK suggestions|none|full
# all behave as "log only" until that API is confirmed.
SMAX_DRY_RUN=true
SMAX_WRITE_BACK=suggestions

# ── Classifier public API (E1-E9) the connector submits incidents to ────────
CLASSIFIER_API_URL=http://localhost:8000
# Inside docker compose the connector reaches the app by service name:
#   CLASSIFIER_API_URL=http://api:8000
CLASSIFIER_API_TOKEN=
