# SMAX connector configuration — all of it lives in this folder.
#
#   cp .env.example .env && edit        # then: python -m integrations.smax.main
#
# The connector runs as its own process and imports nothing from the classifier
# app. These values are read from the environment; the `.env` beside this file is
# loaded automatically when present, and real environment variables always win:
#
#   SMAX_API_TOKEN=… python -m integrations.smax.main    # overrides the file
#
# Nothing SMAX-related is needed in the app's .env (repo root). The only value
# the two sides share is the classifier token: CLASSIFIER_API_TOKEN here must
# equal the server's INTEGRATION_API_TOKEN.

# ── SMAX — the upstream ticketing system (required when the SMAX side runs) ──
SMAX_API_URL=
SMAX_API_TOKEN=
# Write-back gate: true (default) only LOGS the suggestion payload it would post.
SMAX_DRY_RUN=true
# Write-back mode: none | suggestions (default, side channel) | full
SMAX_WRITE_BACK=suggestions
# Poll interval for the SMAX change poller (seconds)
SMAX_POLL_S=60
# Local since-stamp file — runtime state, never committed
SMAX_SYNC_STAMP_PATH=./.last_sync

# ── Classifier public API (E1-E9) the connector submits incidents to ────────
CLASSIFIER_API_URL=http://localhost:8000
# Inside docker compose the connector reaches the app by service name:
#   CLASSIFIER_API_URL=http://api:8000
CLASSIFIER_API_TOKEN=
